# The channel to join (the streamer's channel, lowercase)
TWITCH_CHANNEL=yourchannel

# The bot account used to join chat (can be your own account)
TWITCH_BOT_USERNAME=yourbotname

# OAuth token (see README "Getting a token" for current instructions).
# Must start with "oauth:" (the app also normalizes this for you).
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Web server port
PORT=3000
